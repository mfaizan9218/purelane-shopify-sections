{% comment %}
  Purelane — Product Grid ("Bestsellers")
  Pulls products directly from a merchant-selected Shopify COLLECTION (not
  hand-picked blocks) — add/remove/reorder products in Shopify admin and
  this section updates automatically. "Pill" badges (Best seller / New /
  Top rated) are derived from product tags rather than typed in, so they
  stay correct as merchandising changes without editing the theme.

  Required product tags (optional, purely cosmetic if omitted):
    bestseller | new | top-rated
{% endcomment %}

{% liquid
  assign collection = section.settings.collection
  assign limit = section.settings.product_limit
%}

<section class="purelane-section pl-shop" aria-labelledby="pl-shop-heading-{{ section.id }}">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {% if section.settings.kicker != blank %}<span class="pl-kicker">{{ section.settings.kicker }}</span>{% endif %}
      <h2 class="pl-d2" id="pl-shop-heading-{{ section.id }}" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="pl-rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    {% if collection != blank and collection.products.size > 0 %}
      <div class="pl-shelf" role="list">
        {% for product in collection.products limit: limit %}
          {% assign variant = product.selected_or_first_available_variant %}
          {% liquid
            assign pill = ''
            if product.tags contains 'bestseller'
              assign pill = 'Best seller'
            elsif product.tags contains 'new'
              assign pill = 'New'
            elsif product.tags contains 'top-rated'
              assign pill = 'Top rated'
            endif
          %}
          <article class="pl-glass pl-card pl-rv {% if forloop.index0 > 0 %}pl-rv-d{{ forloop.index0 | at_most: 5 }}{% endif %}" role="listitem">
            <a href="{{ product.url }}" class="pl-shot" aria-label="{{ product.title | escape }}">
              {% if pill != blank %}<span class="pl-pill">{{ pill }}</span>{% endif %}
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 400 }}"
                  srcset="{{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 600 }} 600w"
                  sizes="(min-width: 860px) 22vw, 45vw"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  loading="lazy"
                >
              {% endif %}
            </a>

            <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>

            {% if product.metafields.reviews.rating.value %}
              <div class="pl-rate">
                <b aria-hidden="true">★ {{ product.metafields.reviews.rating.value }}</b>
                <span class="pl-vh">Rated {{ product.metafields.reviews.rating.value }} out of {{ product.metafields.reviews.rating.value.scale_max | default: 5 }}</span>
                · {{ product.metafields.reviews.rating_count }} reviews
              </div>
            {% endif %}

            <div class="pl-pr">
              <strong>{{ product.price | money }}</strong>
              {% if product.compare_at_price > product.price %}
                <s>{{ product.compare_at_price | money }}</s>
                {% assign pct_off = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price %}
                <em>{{ pct_off | round }}% off</em>
              {% endif %}
            </div>

            {% if product.has_only_default_variant and product.available %}
              {% form 'product', product, class: 'pl-atc-form', data-pl-atc-form: '' %}
                <input type="hidden" name="id" value="{{ variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="pl-btn pl-btn-ghost pl-btn-sm" name="add" data-pl-atc-btn {% if variant.available == false %}disabled{% endif %}>
                  <span data-pl-atc-label>{% if variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
                </button>
                <div class="pl-vh" role="status" aria-live="polite" data-pl-atc-status></div>
              {% endform %}
            {% else %}
              <a class="pl-btn pl-btn-ghost pl-btn-sm" href="{{ product.url }}">
                {% if product.available %}Choose options{% else %}Sold out{% endif %}
              </a>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% else %}
      <p class="pl-lede" style="margin:0 auto;text-align:center">Select a collection in the theme editor to populate this grid.</p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
.pl-shelf{display:grid;gap:14px;grid-template-columns:repeat(2,1fr)}
@media(min-width:860px){.pl-shelf{grid-template-columns:repeat(4,1fr)}}
.pl-card{padding:16px;display:flex;flex-direction:column;transition:.4s var(--pl-ease)}
.pl-card:hover{transform:translateY(-5px)}
.pl-card .pl-shot{height:150px;border-radius:14px;margin-bottom:14px;display:grid;place-items:center;position:relative;overflow:hidden;background:linear-gradient(160deg,rgba(236,230,247,.12),rgba(75,58,143,.2));border:1px solid rgba(236,230,247,.14)}
.pl-card .pl-shot img{height:100%;width:100%;object-fit:contain}
.pl-card .pl-pill{position:absolute;top:9px;left:9px;z-index:1;font-size:8.5px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;padding:4px 9px;border-radius:999px;background:rgba(23,16,43,.6);border:1px solid rgba(240,160,60,.32);color:var(--pl-accent)}
.pl-card h3{font-family:'Outfit',sans-serif;font-size:13.5px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;color:var(--pl-surface);line-height:1.2;margin:0 0 7px}
.pl-card h3 a{transition:.25s}
.pl-card h3 a:hover{color:var(--pl-accent)}
.pl-card .pl-rate{font-size:11.5px;color:var(--pl-paper-2);margin-bottom:10px;display:flex;align-items:center;gap:5px;flex-wrap:wrap}
.pl-card .pl-rate b{color:var(--pl-accent);font-weight:700}
.pl-card .pl-pr{margin-top:auto;display:flex;align-items:baseline;gap:8px;margin-bottom:12px;flex-wrap:wrap}
.pl-card .pl-pr strong{font-family:'Outfit',sans-serif;font-size:18px;color:var(--pl-surface);font-weight:700}
.pl-card .pl-pr s{font-size:12px;color:var(--pl-paper-3)}
.pl-card .pl-pr em{font-style:normal;font-size:10px;font-weight:800;letter-spacing:.08em;color:var(--pl-accent)}
.pl-card form,.pl-card .pl-btn{width:100%}
.pl-card .pl-btn{justify-content:center}
{% endstylesheet %}

{% comment %}
  AJAX add-to-cart, wired into Dawn's real cart UI (see purelane-product-grid
  README notes for full explanation) — POSTs JSON to routes.cart_add_url,
  re-fetches cart-drawer/cart-notification sections and swaps them in.
{% endcomment %}
<script>
(function () {
  var section = document.querySelector('[aria-labelledby="pl-shop-heading-{{ section.id }}"]');
  if (!section) return;

  section.querySelectorAll('[data-pl-atc-form]').forEach(function (form) {
    form.addEventListener('submit', function (evt) {
      evt.preventDefault();
      var btn = form.querySelector('[data-pl-atc-btn]');
      var label = form.querySelector('[data-pl-atc-label]');
      var status = form.querySelector('[data-pl-atc-status]');
      if (btn.disabled) return;

      var originalLabel = label.textContent;
      btn.disabled = true;
      label.textContent = 'Adding…';

      var formData = new FormData(form);
      var body = JSON.stringify({
        items: [{ id: formData.get('id'), quantity: formData.get('quantity') || 1 }]
      });

      fetch('{{ routes.cart_add_url }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: body
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (data.status) throw new Error(data.description || 'Could not add to cart');

          label.textContent = 'Added ✓';
          status.textContent = 'Item added to cart';
          document.dispatchEvent(new CustomEvent('pl:cart:added', { detail: data, bubbles: true }));

          var cartDrawer = document.querySelector('cart-drawer');
          var cartNotification = document.querySelector('cart-notification');

          if (cartDrawer && typeof cartDrawer.renderContents === 'function') {
            fetch('{{ routes.cart_url }}?sections=cart-drawer,cart-icon-bubble')
              .then(function (r) { return r.json(); })
              .then(function (sections) { cartDrawer.renderContents({ sections: sections }); });
          } else if (cartNotification && typeof cartNotification.renderContents === 'function') {
            fetch('{{ routes.cart_url }}?sections=cart-notification,cart-icon-bubble')
              .then(function (r) { return r.json(); })
              .then(function (sections) { cartNotification.renderContents({ sections: sections }); });
          }

          setTimeout(function () { label.textContent = originalLabel; btn.disabled = false; }, 1800);
        })
        .catch(function (err) {
          label.textContent = 'Try again';
          status.textContent = err.message;
          btn.disabled = false;
        });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Purelane Product Grid",
  "tag": "section",
  "class": "purelane-product-grid-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Products pull automatically from this collection, in the collection's own sort order." },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Purelane Product Grid" }]
}
{% endschema %}
