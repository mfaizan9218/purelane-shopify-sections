{% comment %}
  Purelane — Reviews Rail (auto-scrolling marquee)

  WHAT'S ACTUALLY LIVE FROM JUDGE.ME vs WHAT'S CURATED, AND WHY:

  Judge.me writes two things to Shopify metafields that are officially
  documented and safe to read directly in Liquid:
    - product.metafields.reviews.rating.value / rating_count  (per product)
    - shop.metafields.judgeme.all_reviews_rating / all_reviews_count (store-wide)
  Both are used below and ARE live — pull real numbers, no manual entry.

  Judge.me also writes product.metafields.judgeme.review_widget_data, which
  contains the individual review text/author/etc — but Judge.me's own docs
  show this metafield being dumped raw into a <script> tag for their own
  JS widget to read (`jdgm.data.reviewWidget[id] = {{ ...review_widget_data }}`).
  Its internal JSON shape isn't published as a stable public API, so looping
  over it ourselves in Liquid to build custom-styled cards would mean
  depending on an undocumented structure Judge.me could change without
  notice, silently breaking this section. That's not a responsible
  foundation for a production section.

  So: each marquee card below is tied to a real product (via block setting)
  and shows that product's REAL, LIVE star rating (from the documented
  metafield). The headline/quote/author is merchant-curated text — which is
  also just standard practice for a homepage highlight reel (brands hand-
  pick their best quotes; they don't stream every raw review onto the
  homepage). If a fully-automated, zero-curation feed of every review is a
  hard requirement, the correct supported path is Judge.me's own official
  review-widget embed (see the `judgeme_official_widget` block type below,
  which renders their sanctioned snippet) rather than reverse-engineering
  their private JSON.
{% endcomment %}

{% liquid
  assign reviews = section.blocks | where: 'type', 'review'
  assign rating = shop.metafields.judgeme.all_reviews_rating | default: section.settings.fallback_rating
  assign review_count = shop.metafields.judgeme.all_reviews_count | default: section.settings.fallback_review_count
%}

<section class="purelane-section pl-revband" aria-labelledby="pl-rev-heading-{{ section.id }}">
  <div class="pl-wrap">
    <div class="pl-revhead pl-rv">
      <span class="pl-kicker" id="pl-rev-heading-{{ section.id }}">{{ section.settings.kicker }}</span>
      {% if rating != blank %}
        <span class="pl-agg">
          <span class="pl-st" aria-hidden="true">★★★★★</span>
          <span class="pl-vh">Rated {{ rating }} out of 5</span>
          <b>{{ rating }}</b> from {{ review_count }}+ reviews
        </span>
      {% endif %}
      {% if section.settings.homes_count != blank %}
        <span class="pl-agg">Loved by <b>{{ section.settings.homes_count }}</b> homes</span>
      {% endif %}
    </div>
  </div>

  {% if reviews.size > 0 %}
    <div class="pl-revrail pl-rv" aria-label="Customer reviews, autoplaying">
      <div class="pl-revtrack">
        {% comment %} Render the list twice back-to-back for a seamless CSS loop. {% endcomment %}
        {% for pass in (1..2) %}
          {% for block in reviews %}
            {% liquid
              assign product = block.settings.product
              assign live_rating = product.metafields.reviews.rating.value | default: block.settings.rating
            %}
            <article class="pl-glass-2 pl-rcard" {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %} {% if pass == 2 %}aria-hidden="true"{% endif %}>
              <div class="pl-st" aria-hidden="true">
                {% assign rounded_rating = live_rating | round %}
                {% for i in (1..5) %}{% if i <= rounded_rating %}★{% else %}☆{% endif %}{% endfor %}
              </div>
              {% if pass == 1 %}<span class="pl-vh">Rated {{ live_rating }} out of 5</span>{% endif %}
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.quote }}</p>
              <div class="pl-who">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
                <b>{{ block.settings.author }}</b>
                {% if product %}<span>· {{ product.title }}</span>{% elsif block.settings.tag != blank %}<span>· {{ block.settings.tag }}</span>{% endif %}
              </div>
            </article>
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% comment %} Optional: fully-official, fully-live Judge.me widget for one product, if a merchant wants zero-curation review content in addition to the curated marquee above. {% endcomment %}
  {% assign widget_blocks = section.blocks | where: 'type', 'judgeme_official_widget' %}
  {% for block in widget_blocks %}
    {% assign wproduct = block.settings.product %}
    {% if wproduct %}
      <div class="pl-wrap" style="margin-top:20px" {{ block.shopify_attributes }}>
        {% assign has_legacy = false %}
        {% if wproduct.metafields.judgeme.widget.size > 20 %}{% assign has_legacy = true %}{% endif %}
        <div style="clear:both"></div>
        <div
          id="judgeme_product_reviews_{{ wproduct.id }}"
          class="jdgm-widget jdgm-review-widget"
          data-product-title="{{ wproduct.title | escape }}"
          data-id="{{ wproduct.id }}"
          data-product-id="{{ wproduct.id }}"
          data-widget="review"
          data-auto-install="false"
          data-shop-reviews-count="{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}"
        >
          {% if has_legacy %}
            <div class="jdgm-legacy-widget-content" style="display:none">{{ wproduct.metafields.judgeme.widget }}</div>
          {% endif %}
        </div>
        {% if wproduct.metafields.judgeme.review_widget_data %}
          <script>
            window.jdgm = window.jdgm || {};
            jdgm.data = jdgm.data || {};
            jdgm.data.reviewWidget = jdgm.data.reviewWidget || {};
            jdgm.data.reviewWidget[{{ wproduct.id }}] = {{ wproduct.metafields.judgeme.review_widget_data }};
          </script>
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
</section>

{% stylesheet %}
.pl-revband{padding:var(--pl-sec-y) 0}
.pl-revhead{display:flex;align-items:center;justify-content:center;gap:10px 18px;flex-wrap:wrap;margin-bottom:14px}
.pl-revhead .pl-agg{display:inline-flex;align-items:center;gap:8px;font-size:11.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--pl-paper-2)}
.pl-revhead .pl-agg b{font-family:'Outfit',sans-serif;font-size:16px;color:var(--pl-accent);letter-spacing:0}
.pl-revhead .pl-st{color:var(--pl-accent);font-size:12px;letter-spacing:.16em}
.pl-revrail{overflow:hidden;position:relative;-webkit-mask-image:linear-gradient(90deg,transparent,#000 7%,#000 93%,transparent);mask-image:linear-gradient(90deg,transparent,#000 7%,#000 93%,transparent)}
.pl-revtrack{display:flex;gap:12px;width:max-content;animation:pl-marq 52s linear infinite}
.pl-revrail:hover .pl-revtrack,.pl-revrail:focus-within .pl-revtrack{animation-play-state:paused}
@keyframes pl-marq{from{transform:translate3d(0,0,0)}to{transform:translate3d(-50%,0,0)}}
@media (prefers-reduced-motion: reduce){.pl-revtrack{animation:none;flex-wrap:wrap;width:auto}}
.pl-rcard{flex:0 0 auto;width:284px;padding:15px 17px;border-radius:18px}
.pl-rcard .pl-st{color:var(--pl-accent);font-size:10.5px;letter-spacing:.2em;margin-bottom:9px}
.pl-rcard h3{font-family:'Outfit',sans-serif;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--pl-surface);margin:0 0 7px}
.pl-rcard p{font-size:12.6px;color:var(--pl-paper-2);line-height:1.52;margin:0 0 11px}
.pl-rcard .pl-who{display:flex;align-items:center;gap:7px;font-size:9.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--pl-paper-3)}
.pl-rcard .pl-who b{color:var(--pl-surface);font-weight:700}
.pl-rcard .pl-who svg{width:12px;height:12px;color:var(--pl-accent);flex:0 0 auto}
{% endstylesheet %}

{% schema %}
{
  "name": "Purelane Reviews Rail",
  "tag": "section",
  "class": "purelane-reviews-rail-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "That's what they said" },
    { "type": "text", "id": "homes_count", "label": "Homes count label", "default": "12 lakh+" },
    { "type": "header", "content": "Fallback aggregate rating" },
    { "type": "paragraph", "content": "Used only if the Judge.me shop metafields (all_reviews_rating / all_reviews_count) aren't available yet." },
    { "type": "text", "id": "fallback_rating", "label": "Fallback rating", "default": "4.8" },
    { "type": "text", "id": "fallback_review_count", "label": "Fallback review count", "default": "8,000" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Curated review card",
      "settings": [
        { "type": "product", "id": "product", "label": "Linked product", "info": "Star rating is pulled live from this product's Judge.me metafield. Leave blank to use the manual rating below instead." },
        { "type": "range", "id": "rating", "label": "Manual star rating (used if no product linked)", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Headline", "default": "Works like a charm" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better." },
        { "type": "text", "id": "author", "label": "Customer name", "default": "Anita" },
        { "type": "text", "id": "tag", "label": "Product tag (used if no product linked)", "default": "Laundry detergent" }
      ]
    },
    {
      "type": "judgeme_official_widget",
      "name": "Live Judge.me widget (optional)",
      "settings": [
        { "type": "paragraph", "content": "Renders Judge.me's own official, fully-live review widget for one product below the curated marquee — use this if you want a zero-curation feed in addition to the highlight reel above." },
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Purelane Reviews Rail",
      "blocks": [
        { "type": "review" },
        { "type": "review", "settings": { "title": "Best dishwash ever", "quote": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.", "author": "Priya", "tag": "Dishwash gel" } },
        { "type": "review", "settings": { "title": "Dog friendly", "quote": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.", "author": "Rohit S.", "tag": "Floor cleaner" } }
      ]
    }
  ]
}
{% endschema %}
