{% comment %}
  Purelane — Best-Selling Combos
  Each combo card = one real Shopify product from a merchant-selected
  COLLECTION (each product should be a Shopify Bundles product, so its own
  price/compare_at_price/url are the real bundle numbers — nothing here is
  typed in manually). Card content (flag, description override, the 3-item
  tray preview) comes from METAFIELDS on that same product, editable in
  Shopify admin without touching the theme editor.

  Required metafield definitions (Settings → Custom data → Products):

    namespace  key                  type                        required
    ---------  -------------------  --------------------------  --------
    custom     flag_label           single line text            no
    custom     featured             boolean                     no
    custom     combo_description    multi-line text              no  (falls back to product.description)
    custom     combo_items          JSON                         no  (see shape below)

  combo_items JSON shape (array of up to 3 objects):
    [
      { "product": "tap-cleaner-500ml", "benefit": "Melts hard water stains" },
      { "product": "kitchen-cleaner-foaming", "benefit": "Cuts grease instantly" }
    ]
  "product" is the linked product's HANDLE (not id/title) — resolved below
  via all_products['handle']. This is display-only content for the tray;
  it does not affect what's actually added to cart (the bundle product
  itself handles that).
{% endcomment %}

{% liquid
  assign collection = section.settings.collection
  assign limit = section.settings.combo_limit
%}

<section class="purelane-section pl-combos" aria-labelledby="pl-combos-heading-{{ section.id }}">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {% if section.settings.kicker != blank %}<span class="pl-kicker">{{ section.settings.kicker }}</span>{% endif %}
      <h2 class="pl-d2" id="pl-combos-heading-{{ section.id }}" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="pl-rule"><i></i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg><i></i></div>
      {% if section.settings.subheading != blank %}
        <p class="pl-lede" style="margin:14px auto 0">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    {% if collection != blank and collection.products.size > 0 %}
      <div class="pl-comborail pl-rv" role="list" tabindex="0" aria-label="Best-selling combos, scroll for more">
        {% for bundle in collection.products limit: limit %}
          {% liquid
            assign flag_label = bundle.metafields.custom.flag_label
            assign featured = bundle.metafields.custom.featured
            assign description = bundle.metafields.custom.combo_description | default: bundle.description
            assign items = bundle.metafields.custom.combo_items.value | default: bundle.metafields.custom.combo_items
          %}
          <article class="pl-glass pl-combo {% if featured %}pl-hero-combo{% endif %}" role="listitem">
            <div class="pl-tray">
              {% if bundle.compare_at_price > bundle.price %}
                {% assign savings = bundle.compare_at_price | minus: bundle.price %}
                <span class="pl-save">You save {{ savings | money }}</span>
              {% endif %}
              {% if flag_label != blank %}<span class="pl-flag">{{ flag_label }}</span>{% endif %}

              <div class="pl-stack">
                {% if items != blank %}
                  {% for item in items limit: 3 %}
                    {% assign comp_product = all_products[item.product] %}
                    {% if comp_product %}
                      <span class="pl-it">
                        <span class="pl-itimg">
                          <img src="{{ comp_product.featured_image | image_url: width: 160 }}" alt="{{ comp_product.title | escape }}" loading="lazy" width="80" height="80">
                        </span>
                        <span>{{ item.benefit | default: comp_product.title }}</span>
                      </span>
                      {% unless forloop.last %}<span class="pl-plus" aria-hidden="true">+</span>{% endunless %}
                    {% endif %}
                  {% endfor %}
                {% else %}
                  {# Fallback if combo_items metafield isn't set yet: show the bundle's own image once. #}
                  <span class="pl-it">
                    <span class="pl-itimg"><img src="{{ bundle.featured_image | image_url: width: 160 }}" alt="{{ bundle.title | escape }}" loading="lazy" width="80" height="80"></span>
                    <span>{{ bundle.title }}</span>
                  </span>
                {% endif %}
              </div>
            </div>

            <div class="pl-body">
              <h3>{{ bundle.title }}</h3>
              {% if items != blank %}<div class="pl-cnt">{{ items.size }} products</div>{% endif %}
              {% if description != blank %}<p class="pl-inc">{{ description | strip_html | truncate: 140 }}</p>{% endif %}

              <div class="pl-prow">
                <strong>{{ bundle.price | money }}</strong>
                {% if bundle.compare_at_price > bundle.price %}
                  <s>{{ bundle.compare_at_price | money }}</s>
                  <em>Save {{ savings | money }}</em>
                {% endif %}
              </div>
              <div class="pl-fine">Inclusive of all taxes · COD available</div>

              <a class="pl-btn {% if featured %}pl-btn-primary{% else %}pl-btn-ghost{% endif %}" href="{{ bundle.url }}">
                Shop bundle
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              </a>
            </div>
          </article>
        {% endfor %}
      </div>
      <div class="pl-swipecue" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        Swipe for more combos
      </div>
      {% if section.settings.footnote != blank %}<p class="pl-railnote">{{ section.settings.footnote }}</p>{% endif %}
    {% else %}
      <p class="pl-lede" style="margin:0 auto;text-align:center">Select a collection of Shopify Bundles products in the theme editor.</p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
.pl-comborail{display:flex;gap:14px;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;padding-bottom:6px;scrollbar-width:thin}
.pl-comborail::-webkit-scrollbar{height:6px}
.pl-combo{flex:0 0 302px;scroll-snap-align:start;display:flex;flex-direction:column;padding:0;transition:.4s var(--pl-ease)}
.pl-combo:hover{transform:translateY(-5px)}
.pl-combo.pl-hero-combo{border-color:rgba(240,160,60,.42);box-shadow:0 26px 74px rgba(18,12,34,.44),0 0 0 1px rgba(240,160,60,.2),var(--pl-g-inset)}
.pl-tray{padding:14px 14px 13px;border-bottom:1px solid rgba(236,230,247,.13);position:relative}
.pl-save{display:inline-block;font-size:9.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--pl-accent);margin-bottom:10px}
.pl-flag{position:absolute;top:14px;right:14px;font-size:8.6px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;padding:4px 9px;border-radius:999px;background:rgba(240,160,60,.2);color:var(--pl-accent);border:1px solid rgba(240,160,60,.34)}
.pl-stack{display:flex;align-items:center;justify-content:center;gap:8px}
.pl-it{flex:1;text-align:center;font-size:9.5px;color:var(--pl-paper-3);line-height:1.3}
.pl-itimg{display:block;width:56px;height:56px;margin:0 auto 6px;border-radius:12px;background:rgba(236,230,247,.08);display:grid;place-items:center;overflow:hidden}
.pl-itimg img{width:100%;height:100%;object-fit:contain}
.pl-plus{color:var(--pl-paper-3);font-size:16px;font-weight:300}
.pl-body{padding:15px 16px 18px;display:flex;flex-direction:column;flex:1}
.pl-body h3{font-family:'Outfit',sans-serif;font-size:16px;font-weight:700;text-transform:uppercase;color:var(--pl-surface);margin:0}
.pl-cnt{font-size:10.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--pl-paper-3);margin-top:6px}
.pl-inc{font-size:12.4px;color:var(--pl-paper-2);line-height:1.55;margin:11px 0 14px;flex:1}
.pl-prow{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap;margin-bottom:6px}
.pl-prow strong{font-family:'Outfit',sans-serif;font-size:25px;font-weight:800;color:var(--pl-surface);letter-spacing:-.02em}
.pl-prow s{font-size:13px;color:var(--pl-paper-3)}
.pl-prow em{font-style:normal;font-size:9.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent)}
.pl-fine{font-size:10.4px;color:var(--pl-paper-3);margin-bottom:14px}
.pl-combo .pl-btn{width:100%;justify-content:center}
.pl-swipecue{display:flex;align-items:center;gap:8px;justify-content:center;margin-top:12px;font-size:11px;color:var(--pl-paper-3);text-transform:uppercase;letter-spacing:.1em}
.pl-swipecue svg{width:16px;height:16px}
@media(min-width:900px){.pl-swipecue{display:none}}
.pl-railnote{max-width:60ch;margin:14px auto 0;text-align:center;font-size:11.5px;color:var(--pl-paper-3)}
@media(max-width:640px){.pl-combo{flex:0 0 268px}.pl-comborail{margin:0 -14px;padding:4px 14px 12px}}
{% endstylesheet %}

{% schema %}
{
  "name": "Purelane Combos",
  "tag": "section",
  "class": "purelane-combos-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own." },
    { "type": "collection", "id": "collection", "label": "Combos collection", "info": "Each product in this collection should be a Shopify Bundles product. Card content pulls from that product's price + the metafields listed in this section's code comments." },
    { "type": "range", "id": "combo_limit", "label": "Combos to show", "min": 2, "max": 8, "step": 1, "default": 3 },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "Tapping \"Shop bundle\" opens the bundle product page. You can still review contents before you pay." }
  ],
  "presets": [{ "name": "Purelane Combos" }]
}
{% endschema %}
